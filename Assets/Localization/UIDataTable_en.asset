  - m_Id: 10160429266362371
    m_Localized: Official Ant2
    m_Metadata:
      m_Items: []
  - m_Id: 10160429266362372
    m_Localized: Sanitation Ant
    m_Metadata:
      m_Items: []
  - m_Id: 11705510293135360
    m_Localized: A termite might be hiding inside something this time! Try clicking
      anything suspicious!
    m_Metadata:
      m_Items: []
