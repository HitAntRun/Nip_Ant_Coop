%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StoryTable_ko
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 232c66db683ee472ebf30c5c5cb5e662, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4407004487680
    m_Localized: "\uAE4A\uACE0 \uC6B8\uCC3D\uD55C \uC232\uC18D\uC5D0, \uAC80\uC740\uAC1C\uBBF8\uB9C8\uC744\uACFC
      \uD770\uAC1C\uBBF8\uB9C8\uC744\uC774 \uC774\uC6C3\uD574 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4407033847808
    m_Localized: "\uB450 \uB9C8\uC744\uC758 \uAC1C\uBBF8\uB4E4\uC740 \uC11C\uB85C
      \uC0DD\uAE40\uC0C8\uAC00 \uB2EC\uB790\uC9C0\uB9CC, \uB298 \uC815\uB2F5\uAC8C
      \uC9C0\uB0C8\uB2F5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4407033847809
    m_Localized: "\uADF8\uB7EC\uB358 \uC5B4\uB290 \uB0A0, \uB450 \uB9C8\uC744\uC774
      \uD568\uAED8 \uBAA8\uC5EC \uC990\uAC70\uC6B4 \uCD95\uC81C\uB97C \uC5F4\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4407033847810
    m_Localized: "\uADF8\uB7EC\uB098 \uC6C3\uC74C\uC774 \uAC00\uB4DD\uD588\uB358
      \uCD95\uC81C\uB294 \uC21C\uC2DD\uAC04\uC5D0 \uBB34\uC11C\uC6B4 \uC804\uC7C1\uD130\uB85C
      \uBCC0\uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4407033847811
    m_Localized: "\uD770\uC5EC\uC655\uAC1C\uBBF8\uAC00 \uC5B4\uB9B0 \uAC80\uC740\uAC1C\uBBF8
      \uB458\uC744 \uB054\uCC0D\uD558\uAC8C \uBB3C\uC5B4 \uC8FD\uC778 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4407033847812
    m_Localized: "\uC774\uB97C \uBAA9\uACA9\uD55C \uAC80\uC740\uC5EC\uC655\uAC1C\uBBF8\uB294
      \uD06C\uAC8C \uBD84\uB178\uD558\uC5EC \uC804\uC7C1\uC744 \uC120\uD3EC\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4407033847813
    m_Localized: "\uAC80\uC740\uAC1C\uBBF8\uB9C8\uC744\uC740 \uC0AC\uACFC\uB97C \uC694\uAD6C\uD588\uC9C0\uB9CC,
      \uD770\uAC1C\uBBF8\uB9C8\uC744\uC740 \uBC1B\uC544\uB4E4\uC774\uC9C0 \uC54A\uC558\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 4407033847814
    m_Localized: "\uC624\uB79C \uC2F8\uC6C0 \uB05D\uC5D0, \uC9C0\uCE5C \uB450 \uB9C8\uC744\uC740
      \uB9C8\uCE68\uB0B4 \uD734\uC804 \uD611\uC815\uC744 \uB9FA\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4407038042112
    m_Localized: "\uADF8\uB7EC\uB098 \uB108\uBB34 \uB9CE\uC740 \uAC1C\uBBF8\uAC00
      \uC8FD\uC5C8\uACE0, \uB450 \uB9C8\uC744 \uC0AC\uC774\uC758 \uAC08\uB4F1\uC740
      \uC5EC\uC804\uD788 \uB0A8\uC544 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283008
    m_Localized: "\uC624\uB298\uB3C4 \uD3C9\uD654\uB85C\uC6B4 \uAC80\uC740\uAC1C\uBBF8\uB9C8\uC744!
      \uD558\uC9C0\uB9CC \uB9C8\uC744\uC5D0\uB294 \uC2AC\uD508 \uC5ED\uC0AC\uAC00
      \uC788\uC5B4\uC694. \uAC1C\uBBF8\uB825\uC73C\uB85C 162\uB144 \uC804, \uC0AC\uC774\uAC00
      \uC88B\uB358 \uD770\uAC1C\uBBF8\uB9C8\uC744\uACFC \uC804\uC7C1\uC744 \uBC8C\uC778
      \uC774\uB798\uB85C \uCB49 \uD734\uC804 \uC0C1\uD0DC\uC778 \uAC83\uC774\uC9C0\uC694.
      \uBA3C\uC800 \uC798\uBABB\uC744 \uC800\uC9C0\uB978 \uD770\uAC1C\uBBF8\uB4E4\uC740
      \uAC80\uC740\uAC1C\uBBF8\uB4E4\uC5D0\uAC8C \uC544\uC9C1\uAE4C\uC9C0\uB3C4 \uC0AC\uC8C4\uD558\uC9C0
      \uC54A\uC740, \uC544\uC8FC \uB098\uC05C \uAC1C\uBBF8\uB4E4\uC774\uC5D0\uC694.\n\uADF8\uB7F0\uB370
      \uADF8\uAC83\uB3C4 \uBAA8\uC790\uB77C\uC11C, \uC545\uB784\uD55C \uADF8\uB4E4\uC774
      \uB610 \uACC4\uB7B5\uC744 \uAFB8\uBBF8\uB098 \uBD10\uC694! \uAC80\uC740\uAC1C\uBBF8\uB9C8\uC744\uC5D0
      \uD770\uAC1C\uBBF8\uB4E4\uC774 \uBAB0\uB798 \uCE68\uC785\uD574\uC11C\uB294
      \uB9C8\uC744\uC758 \uC9C8\uC11C\uB97C \uD574\uCE58\uB824\uB294 \uAC8C \uC544\uB2C8\uACA0\uC5B4\uC694?
      \uAC80\uC740\uAC1C\uBBF8\uB9C8\uC744\uC758 \uD3C9\uD654\uB97C \uC704\uD574,
      <b>\uD770\uAC1C\uBBF8</b>\uB97C \uBC1C\uACAC\uD558\uC5EC \uC2E0\uACE0\uD569\uC2DC\uB2E4.
      \uC2E0\uACE0\uB97C \uB9CE\uC774 \uD558\uBA74 \uD559\uAD50\uC5D0\uC11C \uD2B9\uBCC4\uD55C
      \uC0C1\uB3C4 \uC900\uB300\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283009
    m_Localized: "\uC120\uC0DD\uB2D8, \uADF8\uB7F0\uB370 \uC804\uC7C1\uC740 \uB458\uC774
      \uB9C9 \uC2F8\uC6B0\uB294 \uAC70\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283010
    m_Localized: "\uADF8\uB7EC\uBA74 \uBA3C\uC800 \uC798\uBABB\uD55C \uCABD\uC774
      \uC0AC\uACFC\uD558\uBA74 \uD654\uD574\uD560 \uC218 \uC788\uB294 \uAC70 \uC544\uB2CC\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283011
    m_Localized: "\uD55C\uCABD\uC774 \uC798\uBABB\uC744 \uC778\uC815\uD55C\uB2E4\uBA74,
      \uC774 \uAC08\uB4F1\uC740 \uD3C9\uD654\uB86D\uAC8C \uB9C8\uBB34\uB9AC\uB410\uACA0\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283012
    m_Localized: "\uD558\uC9C0\uB9CC \uC800\uB4E4\uC740 \uC798\uBABB\uC744 \uC778\uC815\uD558\uC9C0
      \uC54A\uACE0, \uC798\uBABB\uC744 \uB418\uD480\uC774\uD558\uACE0 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283013
    m_Localized: "\uC5ED\uC0AC\uB97C \uBC14\uB85C \uBC30\uC6B0\uC9C0 \uC54A\uB294\uB2E4\uBA74,
      \uD770\uAC1C\uBBF8\uCC98\uB7FC \uC544\uC9D1\uC5D0 \uBE60\uC9C0\uAC8C \uB41C\uB2F5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283014
    m_Localized: "\uC544\uC9C1\uAE4C\uC9C0\uB3C4 \uD770\uAC1C\uBBF8\uB4E4\uC774 \uC6B0\uB9AC\uC5D0\uAC8C
      \uC0AC\uACFC\uD558\uC9C0 \uC54A\uB294 \uC774\uC720\uB294, \uC800\uB4E4\uC758
      \uC65C\uACE1\uB41C \uC5ED\uC0AC \uAD50\uC721 \uD0D3\uC774\uB2C8\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283015
    m_Localized: "\uADF8\uB7EC\uACE0\uBCF4\uB2C8, \uC774\uAC74 \uC9C0\uB09C \uC218\uC5C5\uC2DC\uAC04\uC5D0
      \uC774\uC57C\uAE30\uD588\uC5C8\uC8E0? \uD639\uC2DC \uAE30\uC5B5 \uB098\uB294
      \uD559\uC0DD \uC788\uC73C\uBA74 \uB300\uB2F5\uD574\uBCFC\uAE4C\uC694~?"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283016
    m_Localized: "\uC65C \uD770\uAC1C\uBBF8\uB9C8\uC744\uC5D0\uC11C\uB294 \uADF8\uB807\uAC8C
      \uC65C\uACE1\uB41C \uC5ED\uC0AC \uAD50\uC721\uC744 \uD558\uB294 \uAC78\uAE4C\uC694~?"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283017
    m_Localized: "\uC800\uC694! \uC800 \uC54C\uC544\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283018
    m_Localized: "\uADF8\uAC74 \uBC14\uB85C \uD770\uAC1C\uBBF8\uB4E4\uC774 \uC6B0\uB9AC
      \uAC80\uC740\uAC1C\uBBF8\uC640 \uB2EC\uB9AC \uBE44\uC815\uC0C1\uC801\uC778
      \uB3CC\uC5F0\uBCC0\uC774\uC774\uAE30 \uB54C\uBB38\uC785\uB2C8\uB2E4!!"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283019
    m_Localized: "\uB124, \uADF8\uB807\uC8E0~ \uADF8\uB4E4\uC740 \uC21C\uC218\uD55C
      \uAC80\uC740\uAC1C\uBBF8\uAC00 \uC544\uB2C8\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283020
    m_Localized: "\uAC80\uC740\uAC1C\uBBF8\uC758 \uC720\uC804\uC790\uC5D0 \uB3CC\uC5F0\uBCC0\uC774\uAC00
      \uC0DD\uACA8 \uD0C4\uC0DD\uD55C \uC874\uC7AC\uB4E4\uC774\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283021
    m_Localized: "\uADF8\uB7EC\uB2E4 \uBCF4\uB2C8 \uC6B0\uB9AC \uAC80\uC740\uAC1C\uBBF8\uBCF4\uB2E4\uB3C4
      \uD6E8\uC52C \uBE44\uBB38\uBA85\uC801\uC774\uACE0 \uD3EC\uC545\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283022
    m_Localized: "\u2026 \uCD5C\uADFC\uC5D0\uB294 \uB2E4\uC2DC \uB610 \uC6B0\uB9AC
      \uAC80\uC740\uAC1C\uBBF8\uB9C8\uC744\uC5D0 \uB098\uD0C0\uB098\uC11C\uB294\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283023
    m_Localized: "\uB124? \uC120\uC0DD\uB2D8, \uADF8\uAC8C \uBB34\uC2A8 \uB9D0\uC500\uC774\uC138\uC694??"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283024
    m_Localized: "...\uD558\uC544. \uC5B4\uCC28\uD53C \uC5EC\uB7EC\uBD84\uC5D0\uAC8C\uB3C4
      \uC54C\uB824\uC57C \uD560 \uC0AC\uC2E4\uC774\uC5C8\uC73C\uB2C8\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283025
    m_Localized: "\uC2E4\uC740, \uADF8\uAC83 \uB54C\uBB38\uC5D0 \uC6B0\uB9AC \uAC80\uC740\uAC1C\uBBF8\uB9C8\uC744\uC5D0
      \uC704\uAE30\uAC00 \uB2E5\uCCE4\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283026
    m_Localized: "\uC5EC\uB7EC\uBD84, \uC774\uAC74 \uC804\uCCB4 \uACF5\uC9C0\uC0AC\uD56D\uC774\uB2C8
      \uC798 \uB4E4\uC5B4\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283027
    m_Localized: "<b>\uCD5C\uADFC \uB4E4\uC5B4, \uAC80\uC740\uAC1C\uBBF8\uB9C8\uC744\uC5D0
      \uD770\uAC1C\uBBF8\uB4E4\uC774 \uBAB0\uB798 \uCE68\uC785\uD558\uACE0 \uC788\uB2E4\uACE0
      \uD574\uC694.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283028
    m_Localized: "\uB124?? \uC544\uB2C8, \uC5B4\uB5BB\uAC8C \uADF8\uB7F0 \uC77C\uC774!!"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283029
    m_Localized: "\uBAB0\uB798 \uCE68\uC785\uD574\uC11C \uBB58 \uD558\uB824\uB294
      \uAC70\uC8E0?? \uC124\uB9C8 \uC6B0\uB9AC\uB97C \uBAB0\uB798 \uC8FD\uC774\uB824\uB294
      \uAC74\uAC00\uC694?!"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283030
    m_Localized: "\uADF8\uB4E4\uC740 \uD770\uAC1C\uBBF8\uB9C8\uC744\uC5D0\uC11C \uBCF4\uB0B8
      \uC2A4\uD30C\uC774\uB4E4\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283031
    m_Localized: "\uC2A4\uD30C\uC774\uB4E4\uC740 \uC6B0\uB9AC\uC758 \uC2DD\uB7C9
      \uCC3D\uACE0\uB97C \uC624\uC5FC\uC2DC\uD0A4\uAC70\uB098 \uB9C8\uC744\uC758
      \uAE30\uBB3C\uC744 \uD30C\uC190\uD558\uAE30\uB3C4 \uBAA8\uC790\uB77C,"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283032
    m_Localized: "\uC5B4\uB9B0 \uC560\uBC8C\uB808\uC640 \uC54C\uB4E4\uAE4C\uC9C0\uB3C4
      \uAC74\uB4DC\uB9AC\uB824 \uD55C \uC0AC\uC2E4\uC774 \uBC1D\uD600\uC84C\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283033
    m_Localized: "\uADF8\uB7F0 \uC794\uC778\uD55C...!"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283034
    m_Localized: "\uC774...! \uB098\uC05C \uB188\uB4E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283035
    m_Localized: "\uADF8\uB9AC\uACE0 \uC694 \uBA70\uCE60, \uB9C8\uC744 \uACF3\uACF3\uC758
      \uAC1C\uBBF8\uAD74\uC5D0\uC11C \uD770\uAC1C\uBBF8\uAC00 \uBC1C\uACAC\uB418\uC5C8\uB2E4\uB294
      \uC2E0\uACE0\uAC00 \uC787\uB530\uB974\uACE0 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283036
    m_Localized: "\uD770\uAC1C\uBBF8\uB4E4\uC774 \uC774\uBBF8 \uAC80\uC740\uAC1C\uBBF8\uB9C8\uC744\uC758
      \uAE4A\uC219\uD55C \uACF3\uBD80\uD130 \uBAB0\uB798 \uC6B0\uB9AC\uC758 \uC9C8\uC11C\uB97C
      \uD574\uCE58\uB824 \uD558\uB294 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283037
    m_Localized: "\uADF8\uB7FC \uC5B4\uB5A1\uD574\uC694? \uBE68\uB9AC \uADF8 \uB140\uC11D\uB4E4\uC744
      \uC7A1\uC544\uC57C \uD558\uC796\uC544\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 676906218283038
    m_Localized: "\uADF8\uB798\uC11C \uC120\uC0DD\uB2D8\uC774 \uC5EC\uB7EC\uBD84\uC5D0\uAC8C
      \uC804\uB2EC\uD560 \uC911\uC694\uD55C, \uC815\uB9D0 \uC911\uC694\uD55C \uC0AC\uD56D\uC740
      \uC9C0\uAE08\uBD80\uD130\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477312
    m_Localized: "<b>\uD770\uAC1C\uBBF8\uB97C \uBC1C\uACAC\uD558\uBA74 \uC811\uCD09\uD558\uC9C0
      \uB9D0\uACE0 \uC989\uC2DC \uC2E0\uACE0\uD558\uC138\uC694.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477313
    m_Localized: "\uB9CE\uC774 \uCC3E\uC544 \uC2E0\uACE0\uD55C \uD559\uC0DD\uC5D0\uAC8C\uB294
      \uD2B9\uBCC4\uD55C \uC0C1\uC744 \uC904 \uC608\uC815\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477314
    m_Localized: "\uC5B4\uCA4C\uBA74 \uC5EC\uB7EC\uBD84 \uC911 \uB204\uAD70\uAC00\uAC00
      \uB9C8\uC744\uC758 \uC601\uC6C5\uC774 \uB420 \uAE30\uD68C\uC77C\uC9C0\uB3C4
      \uBAB0\uB77C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477315
    m_Localized: "(\uC194\uAE43)"
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477316
    m_Localized: "\uC2DC\uAC04\uC774 \uB2E4 \uB418\uC5C8\uC73C\uB2C8, \uC624\uB298
      \uC218\uC5C5\uC740 \uC5EC\uAE30\uC11C \uB9C8\uCE58\uACA0\uC2B5\uB2C8\uB2E4.
      \uBAA8\uB450\uB4E4, \uC9D1\uAE4C\uC9C0 \uC870\uC2EC\uD788 \uAC00\uC694~"
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477317
    m_Localized: "\uD770\uAC1C\uBBF8 \uC2E0\uACE0\uD558\uAE30\uB77C... \uBCC4\uB85C
      \uC5B4\uB835\uC9C0 \uC54A\uC744 \uAC83 \uAC19\uC740\uB370?"
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477318
    m_Localized: "\uB098\uC05C \uD770\uAC1C\uBBF8\uB4E4\uC744 \uC7A1\uC544\uC11C,
      \uB098\uB3C4 \uB9C8\uC744\uC758 \uC601\uC6C5\uC73C\uB85C \uAC70\uB4ED\uB098\uB294
      \uAC70\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477319
    m_Localized: "\uADF8\uB7EC\uBA74 \uC544\uBE60\uB3C4 \uC5C4\uB9C8\uB3C4 \uAE30\uBED0\uD558\uC2DC\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477320
    m_Localized: "\uC624\uB298\uBD80\uD130 \uB9C8\uC744 \uACF3\uACF3\uC744 \uB3CC\uC544\uB2E4\uB2C8\uBA74\uC11C
      \uD770\uAC1C\uBBF8\uB97C \uCC3E\uC544\uBD10\uC57C\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477322
    m_Localized: "\uB2E4\uB140\uC654\uC2B5\uB2C8\uB2E4...~"
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477323
    m_Localized: "\uC870\uAE08 \uD53C\uACE4\uD558\uAE34 \uD55C\uB370, \uADF8\uB798\uB3C4
      \uD560 \uB9CC\uD55C \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477324
    m_Localized: ......
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477325
    m_Localized: "...... \uAC71\uC815 \uB9C8\uC138\uC694, \uC544\uBE60."
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477326
    m_Localized: "\uB9C8\uC744\uB9CC\uD07C\uC740 \uC81C\uAC00 \uAF2D \uC9C0\uD0AC
      \uD14C\uB2C8\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477327
    m_Localized: "\uADF8\uB7EC\uBA74 \uC544\uBE60\uB3C4 \uC870\uAE08\uC740 \uD6C4\uB828\uD558\uC2DC\uACA0\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477328
    m_Localized: "\uADF8\uB7FC, \uB0B4\uC77C \uB610 \uC778\uC0AC\uD560\uAC8C\uC694.
      \uC548\uB155\uD788 \uC8FC\uBB34\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477329
    m_Localized: "\uD6C4\uC544\uC554, \uC878\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 676906222477330
    m_Localized: Zzzz....
    m_Metadata:
      m_Items: []
  - m_Id: 4015424197877760
    m_Localized: "\uC0B4\uC544\uC788\uB294 \uAC1C\uBBF8\uC640 \uC8FD\uC740 \uAC1C\uBBF8\uC758
      \uBAB8\uC5D0\uC11C \uBC1C\uC0B0\uB418\uB294 \uD398\uB85C\uBAAC\uC740 \uADF8
      \uD654\uD559\uC801 \uC131\uC9C8\uC774 \uB2E4\uB974\uB300\uC694. \uB0B4\uC6A9\uC774
      \uC5B4\uB824\uC6CC\uC11C, \uC218\uC5C5\uC744 \uC5F4\uC2EC\uD788 \uB4E3\uACE0
      \uBCF5\uC2B5\uB3C4 \uD2C8\uD2C8\uC774 \uD574\uC57C\uD560 \uAC83 \uAC19\uC544\uC694.
      \uADF8\uB098\uC800\uB098 \uCE5C\uAD6C\uAC00 \uD770\uAC1C\uBBF8\uB97C \uB108\uBB34
      \uC5F4\uC2EC\uD788 \uCC3E\uC544\uB2E4\uB2CC \uB098\uBA38\uC9C0 \uBAB8\uC0B4\uC774
      \uB098\uC11C \uD559\uAD50\uC5D0 \uC624\uC9C0 \uBABB\uD588\uB300\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424214654976
    m_Localized: "\uC774\uBC88 \uC2DC\uAC04\uC5D0\uB294 \uC6B0\uB9AC\uC758 \uBAB8\uC5D0\uC11C
      \uB098\uC624\uB294 \uD654\uD559\uBB3C\uC9C8\uC5D0 \uB300\uD574 \uC54C\uC544\uBCFC
      \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849280
    m_Localized: "\uC120\uC0DD\uB2D8, \uC544\uC9C1 \uD55C \uCE5C\uAD6C \uC548 \uC654\uB294\uB370\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849281
    m_Localized: "\uBAA8\uB450\uAC00 \uACF5\uD3C9\uD558\uAC8C \uC218\uC5C5\uC744
      \uB4E4\uC5B4\uC57C \uD558\uB2C8\uAE4C \uCE5C\uAD6C \uC624\uBA74 \uC218\uC5C5\uD558\uC2DC\uC8E0!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849282
    m_Localized: "\uC624\uB298 \uCE5C\uAD6C\uB294 \uBAB8\uC774 \uC544\uD30C\uC11C
      \uBABB \uC628\uB2E4\uACE0 \uC5F0\uB77D\uC774 \uC654\uC5B4\uC694~"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849283
    m_Localized: "\uC5E5, \uC65C\uC694? \uC5B4\uCA4C\uB2E4\uAC00 \uC544\uD504\uB300\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849284
    m_Localized: "\uD770\uAC1C\uBBF8\uB97C \uB108\uBB34 \uC5F4\uC2EC\uD788 \uCC3E\uC544\uB2E4\uB140\uC11C
      \uBAB8\uC0B4\uC774 \uB09C \uBAA8\uC591\uC774\uC5D0\uC694~"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849285
    m_Localized: "\uAC54\uAC00 \uADF8\uB807\uAC8C \uC5F4\uC2EC\uD788 \uD560 \uC560\uAC00
      \uC544\uB2CC\uB370...?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849286
    m_Localized: "\uC5B4\uCA0C\uB4E0, \uC5EC\uB7EC\uBD84\uB3C4 \uC544\uD504\uC9C0
      \uC54A\uAC8C, \uC790\uC2E0\uC758 \uBAB8\uC5D0 \uB300\uD574 \uC798 \uC54C\uACE0
      \uC788\uC5B4\uC57C\uC9C0\uC694~"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849287
    m_Localized: "\uC218\uC5C5 \uB05D\uB098\uACE0 \uAC04\uB2E8\uD55C \uD034\uC988\uB97C
      \uB0BC \uD14C\uB2C8 \uC9D1\uC911\uD574\uC8FC\uC138\uC694~"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849288
    m_Localized: "\uB124..."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849289
    m_Localized: "\uC790, \uC67C\uCABD\uC5D0 \uC788\uB294 \uBD84\uC790\uAD6C\uC870\uAC00
      \uBC14\uB85C \uC0B4\uC544\uC788\uB294 \uAC1C\uBBF8\uC758 \uBAB8\uC5D0\uC11C
      \uB098\uC624\uB294 \uD398\uB85C\uBAAC \uBD84\uC790\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849290
    m_Localized: "\uC774\uAC74 \uAC80\uC740\uAC1C\uBBF8\uC640 \uD770\uAC1C\uBBF8\uC5D0
      \uAD00\uACC4 \uC5C6\uC774, \uBAA8\uB4E0 \uC0B4\uC544\uC788\uB294 \uAC1C\uBBF8\uAC00
      \uACF5\uD1B5\uC801\uC73C\uB85C \uBC1C\uC0B0\uD558\uB294 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849291
    m_Localized: "\uD558\uC9C0\uB9CC \uC8FD\uC740 \uAC1C\uBBF8\uC758 \uBAB8\uC5D0\uC11C\uB294
      \uC804\uD600 \uB2E4\uB978 \uBB3C\uC9C8\uC774 \uB098\uC624\uB294\uB370,"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849292
    m_Localized: "\uBC14\uB85C <b>\uC62C\uB808\uC0B0</b>\uC774\uB77C\uB294 \uBB3C\uC9C8\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849293
    m_Localized: "\uBAA8\uB4E0 \uAC1C\uBBF8\uB294 \uBAB8\uC5D0\uC11C \uC774 \uC62C\uB808\uC0B0\uC774
      \uBC1C\uC0B0\uB418\uB294\uAC00 \uC544\uB2CC\uAC00\uB85C \uC0DD\uC0AC\uB97C
      \uD310\uB2E8\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849294
    m_Localized: "\uC120\uC0DD\uB2D8, \uC62C\uB808\uC0B0\uC774\uB77C\uB294 \uAC74
      \uAF2D \uC8FD\uC740 \uAC1C\uBBF8\uC758 \uBAB8\uC5D0\uC11C\uB9CC \uB098\uC624\uB294
      \uBB3C\uC9C8\uC774\uC608\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849295
    m_Localized: "\uADF8\uAC74 \uC544\uB2C8\uC5D0\uC694. \uC774 \uBB3C\uC9C8\uC740
      \uC790\uC5F0\uACC4\uC5D0 \uAC00\uC7A5 \uB9CE\uC774 \uC874\uC7AC\uD558\uB294
      \uC9C0\uBC29\uC0B0\uC774\uAE30\uB3C4 \uD558\uAC70\uB4E0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849296
    m_Localized: "\uD2B9\uD788 \uC62C\uB9AC\uBE0C\uC624\uC77C\uC5D0 \uB9CE\uC774
      \uB4E4\uC5B4\uC788\uB2E4\uACE0 \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849297
    m_Localized: "\uC120\uC0DD\uB2D8, \uADF8\uB7EC\uBA74 \uC62C\uB808\uC0B0\uC774
      \uC0B4\uC544\uC788\uB294 \uAC1C\uBBF8\uC758 \uBAB8\uC5D0 \uBB3B\uC73C\uBA74
      \uC5B4\uB5BB\uAC8C \uB418\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849298
    m_Localized: "\uC88B\uC740 \uC9C8\uBB38\uC774\uC5D0\uC694. \uB9CC\uC77C \uC62C\uB808\uC0B0\uC744
      \uC0B4\uC544\uC788\uB294 \uAC1C\uBBF8\uC758 \uBAB8\uC5D0 \uBC14\uB978\uB2E4\uBA74......"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849299
    m_Localized: "<b>\uC0B4\uC544\uC788\uB294 \uAC1C\uBBF8\uB97C \uC8FD\uC740 \uAC1C\uBBF8\uB85C
      \uC624\uC778\uD560 \uC218\uB3C4 \uC788\uC5B4\uC694.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849300
    m_Localized: "\uD760... \uADF8\uB807\uC9C0\uB9CC \uC6B0\uB9AC \uAC80\uC740\uAC1C\uBBF8\uB294
      \uC8FD\uC5C8\uC744 \uB54C \uBAB8\uC774 \uD558\uC597\uAC8C \uBCC0\uD558\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849301
    m_Localized: "\uADFC\uB370 \uBA40\uCA61\uD788 \uC0B4\uC544\uC788\uB294 \uAC80\uC740\uC0C9
      \uBAB8\uC744 \uBCF4\uACE0\uB3C4, \uC62C\uB808\uC0B0 \uD558\uB098 \uB54C\uBB38\uC5D0
      \uC8FD\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD55C\uB2E4\uACE0\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849302
    m_Localized: "\uB300\uCCB4 \uC5B4\uB5BB\uAC8C \uADF8\uB7F0 \uCC29\uAC01\uC744
      \uD558\uAC8C \uB418\uB294 \uAC70\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849303
    m_Localized: "\uADF8\uB7F0 \uC758\uAD6C\uC2EC\uC744 \uD488\uB294 \uAC83\uB3C4
      \uB2F9\uC5F0\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849304
    m_Localized: "\uD558\uC9C0\uB9CC \uC5EC\uB7EC\uBD84, \uAC04\uACFC\uD574\uC11C\uB294
      \uC548\uB420 \uC0AC\uC2E4\uC774 \uD558\uB098 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849305
    m_Localized: "\uC6B0\uB9AC \uAC1C\uBBF8\uB4E4\uC5D0\uAC8C \uC788\uC5B4 '\uC2DC\uAC01'\uC740
      \uADF8\uB2E4\uC9C0 \uC2E0\uB8B0\uD560 \uB9CC\uD55C \uAC10\uAC01\uC774 \uC544\uB2C8\uB77C\uB294
      \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849306
    m_Localized: "\uBB34\uC2A8 \uB9D0\uC778\uC9C0 \uBAA8\uB974\uACA0\uC5B4\uC694
      \uC120\uC0DD\uB2D8."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849307
    m_Localized: "\uC5EC\uB7EC\uBD84\uB3C4 \uC544\uC2DC\uB2E4\uC2DC\uD53C, \uC6B0\uB9AC
      \uAC1C\uBBF8\uB77C\uB294 \uC0DD\uBB3C\uC740 \uC2DC\uB825\uC774 \uB098\uBE60\uC11C
      \uD398\uB85C\uBAAC\uC5D0 \uB9CE\uC774 \uC758\uC874\uD558\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849308
    m_Localized: "\uADF8\uB798\uC11C \uC2DC\uAC01 \uC815\uBCF4\uBCF4\uB2E4\uB3C4,
      \uD398\uB85C\uBAAC\uC744 \uD1B5\uD574 \uC5BB\uC740 \uC815\uBCF4\uB97C \uB354\uC6B1
      \uC2E0\uB8B0\uD558\uAC8C \uB3FC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849309
    m_Localized: "\uADF8\uB7EC\uB2C8\uAE4C \uC62C\uB808\uC0B0\uC774 \uB108\uBB34
      \uAC15\uB825\uD558\uB2E4\uBA74,"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849310
    m_Localized: "<b>\uBD84\uBA85 \uC0B4\uC544\uC788\uB294 \uAC80\uC740 \uAC1C\uBBF8\uB3C4
      \uBAB8\uC774 \uC0C8\uD558\uC597\uAC8C \uBCC0\uD574 \uC8FD\uC740 \uAC83\uCC98\uB7FC
      '\uB290\uAEF4\uC9C0\uB294' \uAC83\uC774\uC9C0\uC694.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849311
    m_Localized: "\uC790, \uADF8\uB7EC\uBA74 \uC9C0\uAE08\uAE4C\uC9C0 \uBC30\uC6B4
      \uAC83\uB4E4\uB85C \uAC04\uB2E8\uD55C \uD034\uC988\uB97C \uB0BC\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849312
    m_Localized: "\uCCAB \uBC88\uC9F8 \uD034\uC988\uC608\uC694. \uAC1C\uBBF8\uAC00
      \uC8FD\uC5C8\uC744 \uB54C, \uC8FD\uC740 \uAC1C\uBBF8\uC758 \uBAB8\uC5D0\uC11C
      \uBD84\uBE44\uB418\uB294 \uBB3C\uC9C8\uC740 \uBB34\uC5C7\uC77C\uAE4C\uC694~?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849313
    m_Localized: "\uC62C\uB808\uC0B0\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849314
    m_Localized: "\uC62C\uB808\uC62C\uB808\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849315
    m_Localized: "\uC815\uB2F5\uC774\uC5D0\uC694~"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849316
    m_Localized: "\uCD95\uAD6C \uC751\uC6D0\uC774\uB77C\uB3C4 \uD558\uB098\uC694~?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849317
    m_Localized: "\uB450 \uBC88\uC9F8 \uD034\uC988\uC608\uC694. \uAC1C\uBBF8\uAC00
      \uB354 \uAC15\uD558\uAC8C \uC778\uC2DD\uD558\uB294 \uC815\uBCF4\uB294 \uB458
      \uC911 \uC5B4\uB290 \uAC83\uC77C\uAE4C\uC694~?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849318
    m_Localized: "\uC2DC\uAC01 \uC815\uBCF4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849319
    m_Localized: "\uD398\uB85C\uBAAC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849320
    m_Localized: "\uB9DE\uC558\uC5B4\uC694~ \uC218\uC5C5\uC744 \uC798 \uB4E4\uC5C8\uAD70\uC694~"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849321
    m_Localized: "\uC218\uC5C5\uC744 \uC5F4\uC2EC\uD788 \uC548 \uB4E4\uC5C8\uB098\uC694~?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849322
    m_Localized: "\uC790, \uADF8\uB7FC \uC774\uBC88 \uC218\uC5C5\uC740 \uC5EC\uAE30\uC11C
      \uB9C8\uBB34\uB9AC\uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849323
    m_Localized: "\uC624\uB298 \uBC30\uC6B4 \uAC8C \uC870\uAE08 \uC5B4\uB824\uC6B8
      \uC218\uB3C4 \uC788\uC73C\uB2C8, \uBCF5\uC2B5\uC740 \uD544\uC218\uB78D\uB2C8\uB2E4~"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424218849324
    m_Localized: "\uD750\uC74C, \uCE5C\uAD6C \uBCD1\uBB38\uC548\uC774\uB77C\uB3C4
      \uAC00\uBCFC\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043584
    m_Localized: "\uADF8\uC804\uC5D0, \uC6B0\uC120 \uD770\uAC1C\uBBF8\uB97C \uB354
      \uC5F4\uC2EC\uD788 \uCC3E\uC544\uC57C\uACA0\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043585
    m_Localized: "\uC624\uB298\uC740 \uC5B4\uC81C \uAC14\uB358 \uACF3 \uB9D0\uACE0,
      \uB2E4\uB978 \uACF3\uC744 \uAC00\uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043586
    m_Localized: "\uBCF4\uD1B5 \uC2A4\uD30C\uC774\uB77C\uBA74, \uC801\uC9C4\uC758
      \uC911\uC694\uD55C \uACF3\uC744 \uB178\uB9AC\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043587
    m_Localized: "\uC9C0\uB09C \uBC88 \uC5ED\uC0AC \uC218\uC5C5\uC5D0\uC11C\uB294
      \uBC30\uAE09\uC774 \uC911\uC694\uD558\uB2E4\uACE0 \uD588\uC73C\uB2C8\uAE4C..."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043588
    m_Localized: "\uC774\uBC88\uC5D4 \uB9C8\uC744 \uC2DD\uB7C9\uCC3D\uACE0\uC5D0
      \uAC00\uC11C \uD770\uAC1C\uBBF8\uB97C \uCC3E\uC544\uBD10\uC57C\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043589
    m_Localized: "\uD559\uAD50\uB97C \uB9C8\uCE58\uACE0 \uCE5C\uAD6C\uB124 \uC9D1\uC5D0
      \uBCD1\uBB38\uC548\uC744 \uAC00\uB824\uACE0 \uD588\uB294\uB370, \uAC00\uB294
      \uAE38\uC5D0 \uB2E4\uB978 \uCE5C\uAD6C\uC640 \uB9C8\uC8FC\uCCE4\uC5B4\uC694.
      \uADF8\uB7EC\uB354\uB2C8 \uC81C\uAC8C \uC194\uAE43\uD55C \uC81C\uC548\uC744
      \uD558\uC9C0 \uBB50\uC608\uC694. \uAE00\uC384, \uC790\uAE30\uAC00 \uD770\uAC1C\uBBF8\uAC00
      \uB4E4\uC5B4\uC624\uB294 \uBE44\uBC00 \uD1B5\uB85C\uB97C \uBC1C\uACAC\uD588\uB2E4\uB294
      \uAC70\uC608\uC694! \uADF8\uB7EC\uBA74\uC11C \uC81C\uAC8C \uAC19\uC774 \uAC00\uC790\uACE0
      \uD558\uB294\uB370, \uC544\uC544, \uBCD1\uBB38\uC548\uACFC \uBE44\uBC00 \uD1B5\uB85C,
      \uC5B4\uB514\uB97C \uAC00\uC57C \uD560\uAE4C\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043590
    m_Localized: "\uC800\uBC88\uC5D0\uB3C4 \uB290\uAF08\uC9C0\uB9CC, \uB140\uC11D\uB4E4\uC758
      \uC8FC\uC704\uC5D0\uC11C \uAF2D \uC369\uC740 \uB0B4\uAC00 \uB09C\uB2E8 \uB9D0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043591
    m_Localized: "\uC73C\uC73C, \uAE30\uBD84 \uB354\uB7EC\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043592
    m_Localized: "\uADF8\uB798\uB3C4 \uC624\uB298\uC740 \uC5B4\uC81C\uBCF4\uB2E4
      \uC5F4\uC2EC\uD788 \uD55C \uAC83 \uAC19\uC73C\uB2C8\uAE4C \uC77C\uCC0D \uB4E4\uC5B4\uAC00\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043593
    m_Localized: "\uC544, \uB9DE\uC544, \uCE5C\uAD6C\uB124 \uC9D1\uC5D0 \uAC00\uBD10\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043594
    m_Localized: "\uC57C~~ \uC5D0\uBC00~~!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043595
    m_Localized: "\uAE5C\uC9DD\uC774\uC57C! \uBB50\uC57C, \uB108\uC600\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043596
    m_Localized: "\uC65C \uADF8\uB807\uAC8C \uB180\uB77C? \uC8C4\uB77C\uB3C4 \uC9C0\uC5C8\uB0D0?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043597
    m_Localized: "\uADF8\uB098\uC800\uB098, \uB9C8\uCE68 \uC798 \uB9CC\uB0AC\uB2E4.
      \uB108, \uB098\uB791 \uC5B4\uB514 \uC880 \uAC19\uC774 \uAC00\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043598
    m_Localized: "\uC5B4\uB514\uB97C?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043599
    m_Localized: "\uD6C4\uD6C4, \uB4E3\uACE0 \uB180\uB77C\uC9C0\uB098 \uB9D0\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043600
    m_Localized: "(\uB450\uB9AC\uBC88 \uB450\uB9AC\uBC88)"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043601
    m_Localized: "\uAC00\uAE4C\uC774 \uC640 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043602
    m_Localized: "\uBB54\uB370 \uADF8\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043603
    m_Localized: "... \uB0B4\uAC00 \uB9D0\uC774\uC9C0, \uD770\uAC1C\uBBF8\uB4E4\uC758
      \uBE44\uBC00 \uD1B5\uB85C\uB97C \uBC1C\uACAC\uD55C \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043604
    m_Localized: ......
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043605
    m_Localized: "... \uBB50\uB77C\uACE0?!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043606
    m_Localized: "\uC26C\uC774\uC774\uC787!! \uC544\uC9C1 \uD655\uC2E4\uD55C \uAC74
      \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043607
    m_Localized: "\uBE44\uBC00 \uD1B5\uB85C\uB97C \uBC1C\uACAC\uD588\uB2E4\uBA74,
      \uAC70\uAE30\uB97C \uB9C9\uC544\uC11C \uB140\uC11D\uB4E4\uC774 \uCCD0\uB4E4\uC5B4\uC624\uC9C0
      \uBABB\uD558\uAC8C \uD560 \uC218 \uC788\uB294 \uAC70\uC796\uC544?!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043608
    m_Localized: "<b>\uBC18\uB300\uB85C \uC6B0\uB9AC\uAC00 \uD770\uAC1C\uBBF8\uB9C8\uC744\uB85C
      \uCCD0\uB4E4\uC5B4\uAC08 \uC218\uB3C4 \uC788\uACA0\uC9C0.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043609
    m_Localized: "...... \uC9C4\uC9DC \uC800\uCABD \uB9C8\uC744\uC5D0 \uC7A0\uC785\uD558\uB824\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043610
    m_Localized: "\uADF8\uAC74 \uB098\uC911\uC5D0 \uC0DD\uAC01\uD558\uACE0. \uC5B4\uCA44\uB4E0,
      \uC9C0\uAE08 \uADF8 \uBE44\uBC00 \uD1B5\uB85C\uB97C \uCC3E\uC73C\uB7EC \uAC08
      \uAC74\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043611
    m_Localized: "\uC2DC\uAC04 \uB418\uBA74 \uB108\uB3C4 \uAC19\uC774 \uBE44\uBC00
      \uD1B5\uB85C \uCC3E\uC73C\uB7EC \uAC00\uC9C0 \uC54A\uC744\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043612
    m_Localized: "\uAC19\uC774 \uAC00\uACE0 \uC2F6\uC9C0\uB9CC, \uBCD1\uBB38\uC548
      \uBA3C\uC800 \uAC00\uBD10\uC57C\uD560 \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043613
    m_Localized: "\uC88B\uC544, \uB098\uB3C4 \uAC08\uB798!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043614
    m_Localized: "\uD558\uC5EC\uAC04 \uC5D0\uBC00, \uB10C \uB108\uBB34 \uCC29\uD574\uC11C
      \uD0C8\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043615
    m_Localized: "\uADF8\uB7FC \uC624\uB298 \uB0B4\uAC00 \uB458\uB7EC\uBCF4\uACE0
      \uB0B4\uC77C \uD559\uAD50\uC5D0\uC11C \uC54C\uB824\uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043616
    m_Localized: "\uB0B4\uC77C\uC740 \uD559\uAD50 \uC26C\uB294 \uB0A0\uC778\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043617
    m_Localized: "\uC544\uC544, \uB9DE\uB2E4. \uAE5C\uBE61\uD588\uB124. \uADF8\uB7FC
      \uC0AC\uD758 \uB4A4\uC5D0 \uC54C\uB824\uC904\uAC8C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043618
    m_Localized: "\uC2DC\uAC04\uC774 \uB354 \uB2A6\uAE30 \uC804\uC5D0, \uB098\uB3C4
      \uBE68\uB9AC \uCE5C\uAD6C\uB124 \uC9D1\uC5D0 \uAC00\uBD10\uC57C\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043619
    m_Localized: "\uC5ED\uC2DC! \uB108\uB791 \uAC19\uC774 \uAC00\uBA74 \uAE08\uBC29
      \uCC3E\uC744 \uC218 \uC788\uC744 \uAC70\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043620
    m_Localized: "? \uC774\uBBF8 \uCC3E\uC558\uB2E4\uB294 \uAC70 \uC544\uB2C8\uC5C8\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043621
    m_Localized: "\uBC1C\uACAC\uD55C \uAC83 '\uAC19\uB2E4'\uB77C\uACE0 \uD588\uC9C0,
      \uBC1C\uACAC\uD588\uB2E4\uACE0\uB294 \uC548 \uD588\uC796\uC544?"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043622
    m_Localized: "...?! \uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043623
    m_Localized: "\uD55C \uC785\uC73C\uB85C \uB450 \uB9D0 \uD558\uAE30 \uC5C6\uAE30~~
      \uC5BC\uB978 \uB530\uB77C\uC624\uB77C\uACE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 4015424223043624
    m_Localized: "\uC6B0\uC774 \uC4B8..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
