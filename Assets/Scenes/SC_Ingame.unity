  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0f577d684c9ea459f89190bdf1ac9559, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  nextSceneName: SC_Ingame
  nextStageId: Stage1_1
  fader: {fileID: 335378076}
  skipLoading: 1
  tutorialPanel: {fileID: 1434988902}
  tutorialText: {fileID: 311207046}
  stepImage: {fileID: 1081609595}
  steps:
  - text: "\uC5B4\uB514 \uD55C\uBC88 \uD558\uC580\uAC1C\uBBF8\uB97C \uCC3E\uC544\uBCFC\uAE4C?"
    trigger: 0
    image: {fileID: 21300000, guid: bd536e0c940054f41b43a7f26d7b9fb9, type: 3}
  - text: "\uC815\uBA74\uC5D0 \uD558\uC580\uAC1C\uBBF8\uAC00 \uC788\uC5C8\uB124?
      \uB9C8\uC6B0\uC2A4 \uC88C\uD074\uB9AD\uC744 \uD1B5\uD574 \uD558\uC580\uAC1C\uBBF8\uB97C
      \uC2E0\uACE0\uD558\uC790!"
    trigger: 1
    image: {fileID: 21300000, guid: 3d07dd4fbd8dc4e5788947d10f28a292, type: 3}
  - text: "\uC774\uBC88\uC5D4 \uC548\uBCF4\uC774\uB294 \uAC01\uB3C4\uC5D0 \uD558\uC580\uAC1C\uBBF8\uAC00
      \uC228\uC5B4\uC788\uC744\uC218 \uC788\uC73C\uB2C8 A,D\uD0A4\uB97C \uB20C\uB7EC
      \uCC3E\uC544\uBCF4\uC790!"
    trigger: 2
    image: {fileID: 21300000, guid: bd536e0c940054f41b43a7f26d7b9fb9, type: 3}
  - text: "\uD558\uC580\uAC1C\uBBF8\uAC00 \uC228\uC5B4\uC788\uC5C8\uB124? \uB611\uAC19\uC774
      \uC2E0\uACE0\uD558\uC790!"
    trigger: 1
    image: {fileID: 21300000, guid: 3d07dd4fbd8dc4e5788947d10f28a292, type: 3}
  - text: "\uB9C8\uC6B0\uC2A4 \uC6B0\uD074\uB9AD\uC744 \uD1B5\uD574 \uD654\uBA74\uC744
      \uD655\uB300\uD574\uBCFC \uC218 \uC788\uC5B4! \uB2E8, \uADF8 \uBD80\uBD84\uB9CC
      \uBCF4\uC774\uB2C8\uAE50 \uC54C\uC544\uB46C!!"
    trigger: 3
    image: {fileID: 21300000, guid: bd536e0c940054f41b43a7f26d7b9fb9, type: 3}
  - text: "\uC774\uBC88\uC5D0\uB3C4 \uC2E0\uACE0\uD574\uBCF4\uC790!"
    trigger: 1
    image: {fileID: 21300000, guid: 3d07dd4fbd8dc4e5788947d10f28a292, type: 3}
  - text: "\uC774\uC81C \uC81C\uB300\uB85C \uD55C\uBC88 \uCC3E\uC544\uBCFC\uAE4C?"
    trigger: 0
    image: {fileID: 21300000, guid: 4be047c3ac44d4187ba969dfaf6bccd0, type: 3}
