--- !u!114 &1783744221
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1783744219}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC624\uB298\uB3C4 \uD3C9\uD654\uB85C\uC6B4 \uAC80\uC740\uAC1C\uBBF8\uB9C8\uC744!
    \uD558\uC9C0\uB9CC \uB9C8\uC744\uC5D0\uB294 \uC2AC\uD508 \uC5ED\uC0AC\uAC00 \uC788\uC5B4\uC694.
    \uBC14\uB85C \uAC1C\uBBF8\uB825\uC73C\uB85C 162\uB144 \uC804, \uC0AC\uC774\uAC00
    \uC88B\uB358 \uD770\uAC1C\uBBF8\uB9C8\uC744\uACFC \uC804\uC7C1\uC744 \uBC8C\uC778
    \uC774\uB798\uB85C \uCB49 \uD734\uC804 \uC0C1\uD0DC\uC778 \uAC83\uC774\uC9C0\uC694.
    \uD770\uAC1C\uBBF8\uB4E4\uC774 \uBA3C\uC800 \uC798\uBABB\uD588\uB294\uB370\uB3C4,
    \uADF8\uB4E4\uC740 \uAC80\uC740\uAC1C\uBBF8\uB4E4\uC5D0\uAC8C \uC0AC\uACFC\uD558\uC9C0
    \uC54A\uB294 \uC544\uC8FC \uB098\uC05C \uAC1C\uBBF8\uB4E4\uC774\uC5D0\uC694.\n\uADF8\uB7F0\uB370
    \uADF8\uAC83\uB3C4 \uBAA8\uC790\uB77C\uC11C, \uD770\uAC1C\uBBF8\uB4E4\uC774 \uCD5C\uADFC
    \uB4E4\uC5B4 \uB610 \uACC4\uB7B5\uC744 \uAFB8\uBBF8\uB098 \uBD10\uC694! \uC544\uB2C8
    \uAE00\uC384, \uAC80\uC740\uAC1C\uBBF8\uB9C8\uC744\uC5D0 \uD770\uAC1C\uBBF8\uB4E4\uC774
    \uBAB0\uB798 \uCE68\uC785\uD558\uACE0 \uC788\uB2E4\uC9C0 \uBB50\uC608\uC694?
    \uB098\uC05C \uD770\uAC1C\uBBF8\uB4E4\uC774 \uAC80\uC740\uAC1C\uBBF8\uB9C8\uC744\uC758
    \uC9C8\uC11C\uB97C \uD574\uCE58\uAE30 \uC804\uC5D0, \uD770\uAC1C\uBBF8\uB97C
    \uBC1C\uACAC\uD558\uBA74 \uBC14\uB85C \uC2E0\uACE0\uD569\uC2DC\uB2E4. \uC2E0\uACE0\uB97C
    \uAC00\uC7A5 \uB9CE\uC774 \uD558\uBA74 \uD559\uAD50\uC5D0\uC11C \uD2B9\uBCC4\uD55C
    \uC0C1\uB3C4 \uC900\uB300\uC694!"
  m_isRightToLeft: 0
